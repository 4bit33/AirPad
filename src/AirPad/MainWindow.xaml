<Window x:Class="AirPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPad — Wireless Display Receiver" Height="720" Width="1080"
        MinHeight="540" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top status bar -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DeviceText, StringFormat=' · {0}'}" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReceiverNameText, StringFormat='📺 {0}'}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IpText, StringFormat='🌐 {0}'}" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="⛶ Fullscreen" Command="{Binding ToggleFullscreenCommand}"/>
                    <Button Content="Hide UI" Command="{Binding ToggleChromeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="0" Visibility="Collapsed" x:Name="HiddenTracker"/>

        <!-- Video area -->
        <Border Grid.Row="1" Background="Black" Margin="12,12,12,6" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Image Source="{Binding VideoBitmap}" Stretch="{Binding VideoStretch}"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding VideoVisible, Converter={StaticResource BoolToVisibilityInverse}}">
                    <TextBlock Text="Waiting for iPad…" FontSize="22" Foreground="#5A6270" HorizontalAlignment="Center"/>
                    <TextBlock Text="1. Press Start Receiver   2. Open Control Center → Screen Mirroring on the iPad   3. Pick this PC"
                               Foreground="#454C58" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="640" TextAlignment="Center"/>
                </StackPanel>
                <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="8"
                        Background="#CC14161A" CornerRadius="6" Padding="8,4"
                        Visibility="{Binding HasNetworkWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NetworkWarning}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Stats + transport -->
        <Border x:Name="BottomBar" Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding FpsText}" Margin="0,0,14,0" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResolutionText}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding OrientationText}" Margin="0,0,14,0" Foreground="{StaticResource DimBrush}"/>
                    <TextBlock Text="{Binding LatencyText}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding CpuText}" Margin="0,0,14,0" Foreground="{StaticResource DimBrush}"/>
                    <TextBlock Text="{Binding GpuText}" Foreground="{StaticResource DimBrush}"/>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶ Start Receiver" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="⏹ Stop" Command="{Binding StopCommand}"/>
                    <Button Content="⏏ Disconnect" Command="{Binding DisconnectCommand}"/>
                    <Button Content="{Binding TestPatternText}" Command="{Binding TestPatternCommand}"/>
                    <Button Content="{Binding MuteText}" Command="{Binding ToggleMuteCommand}"/>
                    <Slider Width="120" Minimum="-30" Maximum="0" TickFrequency="5"
                            ToolTip="Volume (dB, same scale as the iPad)"
                            Value="{Binding VolumeDb, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log -->
        <Expander x:Name="LogPanel" Grid.Row="3" Header="Log" IsExpanded="False" Margin="12,4,12,8"
                  Foreground="{StaticResource DimBrush}">
            <ListBox ItemsSource="{Binding LogLines}" Height="140" Background="#101216"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" FontFamily="Consolas" FontSize="11"/>
        </Expander>
    </Grid>
</Window>
